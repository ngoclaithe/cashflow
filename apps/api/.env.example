TIMEZONE="Asia/Ho_Chi_Minh"

# CORS
CORS_ORIGIN=http://localhost:5173,https://cashflow.dosutech.site

# Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
