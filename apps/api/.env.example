NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cashflow:test1234@127.0.0.1:5432/cashflow?schema=public
JWT_SECRET=cashflow_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=7d

# SePay Integration
SEPAY_API_KEY=
