generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum RuleField {
  DESCRIPTION
  COUNTERPARTY
  AMOUNT
  GATEWAY
}

enum RuleOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
  REGEX
}

enum BudgetPeriod {
  MONTHLY
  CUSTOM
}

enum SyncStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String?
  passwordHash          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  categorizationRules   CategorizationRule[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  savingsGoals          SavingsGoal[]
  auditLogs             AuditLog[]
  systemSettings        SystemSetting[]

  @@map("users")
}

model Account {
  id                 String        @id @default(uuid())
  userId             String
  provider           String        @default("MANUAL") // SEPAY, MBBANK, MANUAL
  externalAccountId  String?
  accountNumber      String?
  accountHolder      String?
  bankName           String?
  displayName        String
  balance            Decimal       @default(0) @db.Decimal(15, 2)
  currency           String        @default("VND")
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  syncRuns           SyncRun[]

  @@unique([userId, provider, accountNumber])
  @@map("accounts")
}

model Category {
  id                  String               @id @default(uuid())
  userId              String
  name                String
  type                CategoryType         @default(EXPENSE)
  color               String?
  icon                String?
  parentId            String?
  isSystem            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Category[]           @relation("CategoryHierarchy")
  transactions        Transaction[]
  categorizationRules CategorizationRule[]
  budgets             Budget[]

  @@unique([userId, name])
  @@map("categories")
}

model CategorizationRule {
  id          String        @id @default(uuid())
  userId      String
  name        String
  priority    Int           @default(0) // Higher value = higher priority
  field       RuleField     @default(DESCRIPTION)
  operator    RuleOperator  @default(CONTAINS)
  value       String
  categoryId  String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("categorization_rules")
}

model Transaction {
  id                     String               @id @default(uuid())
  accountId              String
  userId                 String
  provider               String               @default("MANUAL")
  externalTransactionId  String?
  transactionFingerprint String?
  transactionDate        DateTime
  bookedAt               DateTime?
  amount                 Decimal              @db.Decimal(15, 2) // Always positive absolute value
  currency               String               @default("VND")
  direction              TransactionDirection
  description            String
  counterparty           String?
  code                   String?              // SePay transaction code or reference
  categoryId             String?
  userCategoryOverride   Boolean              @default(false)
  isInternalTransfer     Boolean              @default(false)
  transferRelatedId      String?
  sourcePayload          Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  account                Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category               Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalTransactionId])
  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([direction])
  @@index([transactionFingerprint])
  @@map("transactions")
}

model Budget {
  id          String        @id @default(uuid())
  userId      String
  categoryId  String?       // Null means overall budget
  name        String
  amount      Decimal       @db.Decimal(15, 2)
  period      BudgetPeriod  @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@map("budgets")
}

model RecurringTransaction {
  id                  String               @id @default(uuid())
  userId              String
  name                String
  amount              Decimal              @db.Decimal(15, 2)
  direction           TransactionDirection @default(EXPENSE)
  categoryId          String?
  dayOfMonth          Int                  // e.g. 5 for rent, 10 for salary
  dueDateDescription  String?
  isObligation        Boolean              @default(true) // e.g. Rent obligation
  isActive            Boolean              @default(true)
  lastTriggeredAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recurring_transactions")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(15, 2)
  targetDate    DateTime
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

model SyncRun {
  id                   String     @id @default(uuid())
  provider             String
  accountId            String?
  startedAt            DateTime   @default(now())
  finishedAt           DateTime?
  status               SyncStatus @default(PENDING)
  transactionsFetched  Int        @default(0)
  transactionsInserted Int        @default(0)
  transactionsUpdated  Int        @default(0)
  transactionsSkipped  Int        @default(0)
  errorSummary         String?
  checkpoint           String?
  createdAt            DateTime   @default(now())

  account              Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([provider, startedAt])
  @@map("sync_runs")
}

model ReconciliationLog {
  id                 String   @id @default(uuid())
  runAt              DateTime @default(now())
  windowStart        DateTime
  windowEnd          DateTime
  status             String
  discrepanciesCount Int      @default(0)
  details            Json?
  createdAt          DateTime @default(now())

  @@index([runAt])
  @@map("reconciliation_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("system_settings")
}
