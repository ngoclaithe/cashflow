# Backend API (apps/api/.env)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cashflow:test1234@127.0.0.1:5432/cashflow?schema=public
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
SEPAY_API_KEY=
SEPAY_API_URL=https://userapi.sepay.vn/v2
SEPAY_WEBHOOK_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RECONCILIATION_CRON="30 23 * * *"
TIMEZONE="Asia/Ho_Chi_Minh"
CORS_ORIGIN=http://localhost:5173,https://cashflow.dosutech.site

# Frontend Web (apps/web/.env)
VITE_API_BASE_URL=http://localhost:4000/api
